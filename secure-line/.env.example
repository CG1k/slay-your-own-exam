# Copy to .env and fill in. Never commit the real .env.

# Passcode YOU use to log into the console. Pick something long.
OWNER_PASSCODE=change-me-to-something-long

# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of this app, no trailing slash. Used to build invite links.
PUBLIC_URL=https://your-app.onrender.com

# Port to listen on (most hosts set this for you).
PORT=3000

# ---- Optional: automatic SMS delivery via Twilio ----
# Leave blank to run in manual mode, where the app gives you the link and you
# send it yourself. Manual mode needs no account and no setup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Where to keep the data file.
DATA_FILE=./data/line.json
