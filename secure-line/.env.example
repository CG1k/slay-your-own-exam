# Copy to .env and fill in. Never commit the real .env.

# Passcode YOU use to log into the console. Pick something long.
OWNER_PASSCODE=change-me-to-something-long

# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of this app, no trailing slash. Used to build invite links.
PUBLIC_URL=https://your-app.onrender.com

# Port to listen on (most hosts set this for you).
PORT=3000

# ---- Optional: automatic delivery ----
# Configure any of these and it appears in the console's "Send it with" menu.
# Configure none and everything falls back to manual mode, where the console
# hands you the finished text to send yourself. Manual mode needs no account.
#
# There is no iMessage option. Apple publishes no API for sending iMessage,
# so every service here sends SMS.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=

# VONAGE_FROM can be a name instead of a number (e.g. VERIFY), which is what
# makes the text read as an automated notice. Not allowed for US numbers.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# Where to keep the data file.
DATA_FILE=./data/line.json
